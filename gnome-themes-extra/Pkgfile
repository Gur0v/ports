# Description: Adwaita and HighContrast themes for GTK
# URL: https://gitlab.gnome.org/Archive/gnome-themes-extra
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: adwaita-icon-theme gettext gtk gtk-engines gtk3 intltool librsvg

name=gnome-themes-extra
version=3.28
release=1
source=(https://download.gnome.org/sources/$name/$version/$name-$version.tar.xz)

build() {
    cd $name-$version

    ./configure --prefix=/usr \
        --disable-static
    make
    make DESTDIR=$PKG install
}

# CRUX EFI-only entry point. Reuse upstream EFI targets, not userspace systemd.
project('systemd', 'c', version : '262.2', meson_version : '>=1.3.0',
        default_options : ['c_std=gnu11', 'buildtype=release', 'b_lto=false'])
cc = meson.get_compiler('c')
py = import('python').find_installation('python3')
run_command(py, '-I', '-c', 'import elftools', check : true)
sources = []
boot_stubs = []
project_major_version = '262'
project_minor_version = '2'
version_tag = '262.2'
relative_source_path = import('fs').relative_to(meson.project_source_root(), meson.project_build_root())
bootlibdir = get_option('prefix') / 'lib/systemd/boot/efi'
efi_arch = {'x86_64' : 'x64', 'x86' : 'ia32', 'aarch64' : 'aa64',
            'arm' : 'arm', 'riscv64' : 'riscv64', 'loongarch64' : 'loongarch64'}.get(host_machine.cpu_family(), '')
if efi_arch == ''
        error('Unsupported EFI architecture')
endif
efi_arch_alt = ''
efi_cpu_family_alt = ''
sh = find_program('sh')
elf2efi_py = [py, '-I', files('tools/elf2efi.py')]
check_efi_alignment_py = find_program('python3')
conf = configuration_data()
conf.set_quoted('PROJECT_URL', 'https://systemd.io/')
possible_c_attributes = ['alloc_size', 'fallthrough', 'retain']
conf.set('HAVE_ATTRIBUTE_NO_REORDER', 0)
foreach attr : possible_c_attributes
        conf.set10('HAVE_ATTRIBUTE_' + attr.to_upper(), cc.has_function_attribute(attr))
endforeach
foreach warning : ['zero-length-bounds', 'zero-as-null-pointer-constant']
        conf.set10('HAVE_WARNING_' + warning.underscorify().to_upper(), cc.has_argument('-W' + warning))
endforeach
vconf = configuration_data()
vconf.set('VCS_TAG', '')
version_h = configure_file(input : 'src/version/version.h.in', output : 'version.h', configuration : vconf)
version_include = include_directories('.')
subdir('src/fundamental')
subdir('src/boot')

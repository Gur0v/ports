# Description: Secure PinEntry Dialog with GNOME3 support
# URL: https://gnupg.org/related_software/pinentry/
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: gcr libassuan libcap util-linux
# Optional: gtk libsecret qt5 qt6-base

name=pinentry-gnome3
version=1.3.3
release=1
source=(https://gnupg.org/ftp/gcrypt/pinentry/pinentry-$version.tar.bz2
        pinentry)

build() {
    cd pinentry-$version

    prt-get isinst gtk || PKGMK_PINENTRY+=' --disable-pinentry-gtk2'
    prt-get isinst qt5 || PKGMK_PINENTRY+=' --disable-pinentry-qt5'
    prt-get isinst qt6-base || PKGMK_PINENTRY+=' --disable-pinentry-qt'

    CXXFLAGS+=" -fPIC" \
    ./configure $PKGMK_PINENTRY \
        --prefix=/usr \
        --enable-pinentry-gnome3 \
        --enable-pinentry-curses \
        --enable-pinentry-tty \
        --disable-pinentry-qt4

    make
    make DESTDIR=$PKG install

    rm -rf $PKG/usr/share
    rm $PKG/usr/bin/pinentry
    install -m 755 $SRC/pinentry $PKG/usr/bin/pinentry
}

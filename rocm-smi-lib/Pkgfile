# Description: AMD GPU system management library and command-line tools
# URL: https://github.com/ROCm/rocm-systems
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: cmake libdrm ninja pkgconf python3

name=rocm-smi-lib
version=10.1
release=1
source=(https://github.com/ROCm/rocm-systems/releases/download/therock-$version/$name.tar.gz)

build() {
    cmake -S $name -B build -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
        -D CMAKE_EXPORT_NO_PACKAGE_REGISTRY=ON \
        -D ROCM_SMI_DISABLE=OFF \
        -D BUILD_TESTS=OFF
    cmake --build build
    DESTDIR=$PKG cmake --install build
    install -Dm644 $name/LICENSE.md $PKG/usr/share/licenses/$name/LICENSE
    rm -r $PKG/usr/share/doc
}

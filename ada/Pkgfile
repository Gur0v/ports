# Description: Fast WHATWG-compliant URL parser
# URL: https://github.com/ada-url/ada
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: cmake ninja

name=ada
version=4.0.0
release=1
source=(https://github.com/ada-url/$name/archive/v$version/$name-$version.tar.gz)

build() {
    cmake -S $name-$version -B build -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_INSTALL_LIBDIR=lib \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_C_FLAGS_RELEASE="$CFLAGS" \
        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
        -D CMAKE_POSITION_INDEPENDENT_CODE=ON \
        -D BUILD_SHARED_LIBS=OFF \
        -D ADA_TESTING=OFF \
        -D ADA_BENCHMARKS=OFF \
        -D ADA_TOOLS=OFF
    cmake --build build --target ada
    DESTDIR=$PKG cmake --install build
    install -Dm644 $name-$version/LICENSE-MIT $PKG/usr/share/licenses/$name/LICENSE-MIT
    install -Dm644 $name-$version/LICENSE-APACHE $PKG/usr/share/licenses/$name/LICENSE-APACHE
}

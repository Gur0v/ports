# Description: GTK dialog for updating user folders to match the current locale
# URL: https://gitlab.gnome.org/GNOME/xdg-user-dirs-gtk
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: gtk3 meson ninja xdg-user-dirs

name=xdg-user-dirs-gtk
version=0.16
release=1
source=(https://download.gnome.org/sources/$name/$version/$name-$version.tar.xz
        0001-desktop-Show-in-more-environments.patch)

build() {
    patch -d $name-$version -p1 < $SRC/0001-desktop-Show-in-more-environments.patch

    meson setup $name-$version build \
        --prefix=/usr \
        --sysconfdir=/etc \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true
    meson compile -C build
    DESTDIR=$PKG meson install -C build

    rm -r $PKG/usr/share/locale $PKG/usr/lib/systemd
    rmdir $PKG/usr/lib
}

# Description: Download utility supporting HTTP(S), FTP, SFTP, BitTorrent and Metalink
# URL: https://aria2.github.io/
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: c-ares ca-certificates gnutls libssh2 libxml2 nettle sqlite3 zlib

name=aria2
version=1.37.0
release=1
source=(https://github.com/aria2/aria2/releases/download/release-$version/$name-$version.tar.xz
        nettle-4.patch)

build() {
    cd $name-$version
    patch -p1 -i $SRC/nettle-4.patch

    ./configure --prefix=/usr \
        --enable-libaria2 \
        --disable-static \
        --without-openssl \
        --with-gnutls \
        --with-libnettle \
        --with-libxml2 \
        --with-sqlite3 \
        --with-libcares \
        --with-libssh2 \
        --with-ca-bundle=/etc/ssl/certs/ca-certificates.crt
    make
    make DESTDIR=$PKG install

    install -Dm644 doc/bash_completion/aria2c \
        $PKG/usr/share/bash-completion/completions/aria2c
    rm -r $PKG/usr/share/doc
    rm -f $PKG/usr/lib/libaria2.la
}

# Description: Qt6 configuration utility
# URL: https://www.opencode.net/trialuser/qt6ct
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: cmake ninja qt6-base qt6-svg qt6-tools

name=qt6ct
version=0.11
release=1
source=(https://www.opencode.net/trialuser/$name/-/archive/$version/$name-$version.tar.gz)

build() {
    cmake -S $name-$version -B build -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS"
    cmake --build build
    DESTDIR=$PKG cmake --install build

    install -Dm644 $name-$version/COPYING $PKG/usr/share/licenses/$name/LICENSE
}

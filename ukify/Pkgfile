# Description: Unified Kernel Image builder for non-systemd CRUX
# URL: https://systemd.io/
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: python3 python3-pefile python3-cryptography systemd-boot

name=ukify
version=262.2
release=1
source=(https://github.com/systemd/systemd/archive/refs/tags/v$version.tar.gz)
renames=(systemd-$version.tar.gz)

build() {
    cd systemd-$version
    sed -i -e '1s|^#!/usr/bin/env python3$|#!/usr/bin/python3 -I|' \
        -e "s|{{PROJECT_VERSION}}|$version|g" \
        -e "s|{{VERSION_TAG}}|$version|g" src/ukify/ukify.py
    python3 -I -c 'import pefile, cryptography'
    python3 -I src/ukify/ukify.py --help >/dev/null
    install -Dm755 src/ukify/ukify.py "$PKG/usr/bin/ukify"
    install -Dm644 LICENSE.LGPL2.1 "$PKG/usr/share/licenses/$name/LICENSE.LGPL2.1"
    install -Dm644 LICENSE.GPL2 "$PKG/usr/share/licenses/$name/LICENSE.GPL2"
}

# Description: Resource monitor with CPU, memory, disk, network and GPU statistics
# URL: https://github.com/aristocratos/btop
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on:

name=btop
version=1.4.8
release=1
source=(https://github.com/aristocratos/$name/archive/refs/tags/v$version/$name-$version.tar.gz)

build() {
    cd $name-$version
    make -o btop.1 PREFIX=/usr
    make DESTDIR="$PKG" PREFIX=/usr install
    rm -r "$PKG/usr/share/doc"
}

# Description: Daemon for handling ACPI events
# URL: https://sourceforge.net/projects/acpid2/
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: start-stop-daemon

name=acpid
version=2.0.34
release=1
source=(https://downloads.sourceforge.net/project/acpid2/$name-$version.tar.xz
        acpid)

build() {
    cd $name-$version
    ./configure --prefix=/usr
    make
    make DESTDIR=$PKG install
    install -d $PKG/etc/acpi/events
    install -Dm755 $SRC/acpid $PKG/etc/rc.d/acpid
    rm -r $PKG/usr/share/doc
}

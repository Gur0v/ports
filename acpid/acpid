#!/bin/sh
#
# /etc/rc.d/acpid: start/stop the ACPI event daemon
#

SSD=/sbin/start-stop-daemon
PROG=/usr/sbin/acpid
PIDFILE=/run/acpid.pid

case $1 in
    start)
        $SSD --start --exec $PROG -- --pidfile $PIDFILE
        ;;
    stop)
        $SSD --stop --retry 10 --exec $PROG
        ;;
    restart)
        $0 stop && $0 start
        ;;
    status)
        $SSD --status --exec $PROG
        ;;
    *)
        echo "usage: $0 [start|stop|restart|status]"
        exit 1
        ;;
esac

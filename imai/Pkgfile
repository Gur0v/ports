# Description: Drop-in replacement for CRUX pkgutils written in C
# URL: https://github.com/Gur0v/imai
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: bash bzip2 curl dash libarchive openssl pkgconf signify zlib

name=imai
version=0.1.2
release=1
source=(https://github.com/Gur0v/$name/archive/refs/tags/v$version/$name-$version.tar.gz)

build() {
    cd $name-$version
    make CC="${CC:-cc}" CFLAGS="$CFLAGS -std=c23" \
        LDFLAGS="$LDFLAGS" CRYPTO_LIBS="$(pkg-config --libs libcrypto)"
    make DESTDIR="$PKG" install
}

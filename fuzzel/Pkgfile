# Description: Application launcher for Wayland
# URL: https://codeberg.org/dnkl/fuzzel
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: cairo fcft libpng librsvg libxkbcommon meson ninja python3 scdoc tllist wayland wayland-protocols

name=fuzzel
version=1.15.0
release=1
source=(https://codeberg.org/dnkl/$name/archive/$version.tar.gz)
renames=($name-$version.tar.gz)

build() {
    meson setup $name build \
        --prefix=/usr \
        --sysconfdir=/etc \
        --buildtype=plain \
        --wrap-mode nodownload \
        -D b_lto=true \
        -D b_pie=true \
        -D enable-cairo=enabled \
        -D png-backend=libpng \
        -D svg-backend=librsvg
    meson compile -C build
    DESTDIR=$PKG meson install -C build

    install -Dm644 $name/LICENSE $PKG/usr/share/licenses/$name/LICENSE
    rm -r $PKG/usr/share/doc
}

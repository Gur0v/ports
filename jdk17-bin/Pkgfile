# Description: Eclipse Temurin 17 Java Development Kit (binary)
# URL: https://adoptium.net/
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: alsa-lib cups fontconfig glibc xorg-libx11 xorg-libxext xorg-libxi xorg-libxrender xorg-libxtst

name=jdk17-bin
version=17.0.21+9
release=1
source=(https://github.com/adoptium/temurin17-binaries/releases/download/jdk-${version/+/%2B}/OpenJDK17U-jdk_x64_linux_hotspot_${version/+/_}.tar.gz)

build() {
    install -d "$PKG/usr/lib/java/openjdk17-jdk"
    cp -R jdk-$version/. "$PKG/usr/lib/java/openjdk17-jdk/"

    install -d "$PKG/etc/revdep.d"
    printf '%s\n' /usr/lib/java/openjdk17-jdk/lib \
        /usr/lib/java/openjdk17-jdk/lib/server > "$PKG/etc/revdep.d/openjdk17-jdk"
}

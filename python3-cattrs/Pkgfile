# Description: Composable serialization for attrs classes and dataclasses
# URL: https://github.com/python-attrs/cattrs
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: python3-attrs python3-build python3-hatch-vcs python3-installer python3-typing_extensions

name=python3-cattrs
version=26.2.1
release=1
source=(https://files.pythonhosted.org/packages/source/c/cattrs/cattrs-$version.tar.gz)

build() {
    cd cattrs-$version
    /usr/bin/python3 -m build --wheel --no-isolation --skip-dependency-check
    /usr/bin/python3 -m installer --destdir=$PKG dist/*.whl
}

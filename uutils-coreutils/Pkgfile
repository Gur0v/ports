# Description: Cross-platform core utilities written in Rust
# URL: https://github.com/uutils/coreutils
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: rust

name=uutils-coreutils
version=0.12.0
release=1
source=(https://github.com/uutils/coreutils/archive/$version/$name-$version.tar.gz)

build() {
    cd coreutils-$version
    export CARGO_HOME="$SRC/cargo-home"
    export CARGO_TARGET_DIR="$SRC/target"
    cargo fetch --locked
    make MULTICALL=y PROFILE=release PREFIX=/usr \
        LIBSTDBUF_DIR=/usr/lib/coreutils \
        SKIP_UTILS="arch chcon hostname kill more runcon uptime" \
        COMPLETIONS=n LOCALES=n CARGOFLAGS=--frozen
    make DESTDIR=$PKG MULTICALL=y PROFILE=release PREFIX=/usr \
        LIBSTDBUF_DIR=/usr/lib/coreutils \
        SKIP_UTILS="arch chcon hostname kill more runcon uptime" \
        COMPLETIONS=n LOCALES=n CARGOFLAGS=--frozen install

    install -d $PKG/bin
    mv $PKG/usr/bin/{cat,chgrp,chmod,chown,cp,date,dd,df,echo,false,ln,ls,mkdir,sleep} $PKG/bin
    mv $PKG/usr/bin/{mknod,mv,pwd,readlink,rm,rmdir,stty,sync,touch,true,uname} $PKG/bin
    install -Dm644 LICENSE $PKG/usr/share/licenses/$name/LICENSE
}

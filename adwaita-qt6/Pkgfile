# Description: Adwaita style for Qt6 applications
# URL: https://github.com/FedoraQt/adwaita-qt
# Maintainer: Gurov, thuggerthugger1 at duck dot com
# Depends on: cmake ninja qt6-base

name=adwaita-qt6
version=1.4.2
release=1
source=(https://github.com/FedoraQt/adwaita-qt/archive/$version/adwaita-qt-$version.tar.gz)

build() {
    cmake -S adwaita-qt-$version -B build -G Ninja \
        -D CMAKE_INSTALL_PREFIX=/usr \
        -D CMAKE_BUILD_TYPE=Release \
        -D CMAKE_CXX_FLAGS_RELEASE="$CXXFLAGS" \
        -D USE_QT6=ON
    cmake --build build
    DESTDIR=$PKG cmake --install build
}
